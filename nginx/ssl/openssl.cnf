[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
req_extensions     = req_ext

[ dn ]
C  = TM
ST = Ahal
L  = Ashgabat
O  = Local Network
OU = Dev
CN = 192.168.25.74

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
IP.1  = 192.168.25.74
DNS.1 = localhost
